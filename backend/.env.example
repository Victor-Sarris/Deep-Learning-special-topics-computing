# Copie para .env e ajuste. Nunca comite o .env real (já está no .gitignore).

# Chave secreta do Django (obrigatória em produção).
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte

# "false" desativa o modo debug (use false em produção).
DJANGO_DEBUG=true

# Hosts permitidos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens permitidas para CORS quando DEBUG=false, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Limiar de decisão do modelo (opcional). Abaixe para priorizar recall de falhas.
PREDICT_THRESHOLD=0.5
